{
  "name": "workhorse-parent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Controllable autonomous coding agents — Cloudflare-native fleet orchestrator (Sandbox + Workflows + Pi on Claude subscription)",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "worker",
    "ui",
    "evals"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint packages plugins worker evals",
    "lint:fix": "oxlint --fix packages plugins worker evals",
    "health": "node scripts/health.mjs",
    "health:update": "node scripts/health.mjs --update",
    "health:root": "fallow health --score",
    "audit": "fallow audit",
    "dead": "fallow dead-code",
    "check": "bun run lint && bun run typecheck && bun run health",
    "deploy": "cd worker && bun run deploy",
    "dev": "cd worker && bun run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "cd evals && bun run eval:ci"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "autoevals": "^0.3.0",
    "evalite": "^0.19.0",
    "fallow": "^3.9.1",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "better-sqlite3": "^12.4.1"
  }
}