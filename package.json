{
  "name": "workhorse-parent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Controllable autonomous coding agents \u2014 Cloudflare-native fleet orchestrator (Sandbox + Workflows + Pi on Claude subscription)",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "worker",
    "ui",
    "evals",
    "workflows/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint packages plugins workflows worker evals",
    "lint:fix": "oxlint --fix packages plugins workflows worker evals",
    "health": "node scripts/health.mjs",
    "health:update": "node scripts/health.mjs --update",
    "health:root": "fallow health --score",
    "secrets": "node scripts/secrets.mjs",
    "secrets:missing": "node scripts/secrets.mjs --missing",
    "audit": "fallow audit --coverage coverage/coverage-final.json",
    "dead": "fallow dead-code",
    "check": "bun run lint && bun run typecheck && bun run health",
    "deploy": "cd worker && node pi-build.mjs && bunx wrangler deploy",
    "dev": "cd worker && node pi-build.mjs && bunx wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "BROWSER_CONTRACT=1 vitest run plugins/browser/tools/__tests__/contract.test.ts",
    "eval": "cd evals && bun run eval:ci",
    "eval:tools": "TOOL_SURFACE_EVAL=1 vitest run --project evals",
    "test:contract:imgup": "IMGUP_CONTRACT=1 vitest run plugins/imgup/tools/__tests__/contract.test.ts",
    "test:contract:aft": "AFT_CONTRACT=1 vitest run plugins/aft/tools/__tests__/contract.test.ts",
    "report": "node scripts/report.mjs",
    "report:open": "node scripts/report.mjs --open",
    "report:md": "node scripts/report.mjs --no-tests --markdown",
    "db:generate": "cd packages/db && drizzle-kit generate",
    "db:migrate": "cd packages/db && bun run migrate:local",
    "db:migrate:remote": "cd packages/db && bun run migrate:remote",
    "db:studio": "cd packages/db && drizzle-kit studio",
    "report:assets": "node scripts/report.mjs --assets",
    "test:coverage": "vitest run --coverage",
    "deploy:alchemy:plan": "alchemy deploy --stage prod --adopt --dry-run --yes"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@effect/platform-bun": ">=4.0.0-beta.100",
    "@effect/platform-node": ">=4.0.0-beta.100",
    "@vitest/coverage-istanbul": "4.1.10",
    "alchemy": "^2.0.0-beta.65",
    "autoevals": "^0.3.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "effect": ">=4.0.0-beta.100",
    "evalite": "^0.19.0",
    "fallow": "^3.9.1",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@anthropic-ai/sdk": "0.91.1",
    "@aws-sdk/client-bedrock-runtime": "3.1048.0",
    "@cloudflare/containers": "^0.3.5",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-client": "0.84.1",
    "@earendil-works/pi-protocol": "0.84.1",
    "@earendil-works/pi-telemetry": "^0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@google/genai": "1.52.0",
    "@hono/node-server": "^2.0.3",
    "@hono/standard-validator": "^0.2.0",
    "@mariozechner/clipboard": "0.3.9",
    "@mistralai/mistralai": "2.2.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "1.9.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@smithy/node-http-handler": "4.7.3",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@valibot/to-json-schema": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "aws4fetch": "^1.0.20",
    "capnweb": "^0.8.0",
    "chalk": "5.6.2",
    "content-type": "^1.0.5",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.5",
    "diff": "8.0.4",
    "eventsource": "^3.0.2",
    "eventsource-parser": "^3.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "get-east-asian-width": "1.6.0",
    "glob": "13.0.6",
    "grok-mermaid": "0.2.2",
    "highlight.js": "10.7.3",
    "hono": "^4.12.26",
    "hono-openapi": "^1.3.0",
    "hosted-git-info": "9.0.3",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "ignore": "7.0.5",
    "jiti": "2.7.0",
    "jose": "^6.1.3",
    "js-yaml": "^4.1.1",
    "json-schema-typed": "^8.0.2",
    "just-bash": "^3.0.1",
    "marked": "18.0.5",
    "minimatch": "10.2.5",
    "openai": "6.26.0",
    "openapi-types": "^12.1.3",
    "partial-json": "0.1.7",
    "pkce-challenge": "^5.0.0",
    "proper-lockfile": "4.1.2",
    "quansync": "^0.2.11",
    "raw-body": "^3.0.0",
    "semver": "7.8.0",
    "typebox": "1.1.38",
    "ulidx": "^2.4.1",
    "undici": "8.9.0",
    "valibot": "^1.1.0",
    "yaml": "2.9.0",
    "zod": "^3.25 || ^4.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "overrides": {
    "better-sqlite3": "^12.4.1"
  },
  "dependencies": {
    "evlog": "^2.22.4"
  }
}