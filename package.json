{
  "name": "workhorse-parent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Controllable autonomous coding agents — Cloudflare-native fleet orchestrator (Sandbox + Workflows + Pi on Claude subscription)",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "worker",
    "ui",
    "evals"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint packages plugins worker evals",
    "lint:fix": "oxlint --fix packages plugins worker evals",
    "health": "node scripts/health.mjs",
    "health:update": "node scripts/health.mjs --update",
    "health:root": "fallow health --score",
    "secrets": "node scripts/secrets.mjs",
    "secrets:missing": "node scripts/secrets.mjs --missing",
    "audit": "fallow audit --coverage coverage/coverage-final.json",
    "dead": "fallow dead-code",
    "check": "bun run lint && bun run typecheck && bun run health",
    "deploy": "cd worker && bun run deploy",
    "dev": "cd worker && bun run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "BROWSER_CONTRACT=1 vitest run plugins/browser/tools/__tests__/contract.test.ts",
    "eval": "cd evals && bun run eval:ci",
    "eval:tools": "TOOL_SURFACE_EVAL=1 vitest run --project evals",
    "test:contract:imgup": "IMGUP_CONTRACT=1 vitest run plugins/imgup/tools/__tests__/contract.test.ts",
    "test:contract:aft": "AFT_CONTRACT=1 vitest run plugins/aft/tools/__tests__/contract.test.ts",
    "report": "node scripts/report.mjs",
    "report:open": "node scripts/report.mjs --open",
    "report:md": "node scripts/report.mjs --no-tests --markdown",
    "db:generate": "cd packages/db && drizzle-kit generate",
    "db:migrate": "cd packages/db && bun run migrate:local",
    "db:migrate:remote": "cd packages/db && bun run migrate:remote",
    "db:studio": "cd packages/db && drizzle-kit studio",
    "report:assets": "node scripts/report.mjs --assets",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@vitest/coverage-istanbul": "4.1.10",
    "autoevals": "^0.3.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "evalite": "^0.19.0",
    "fallow": "^3.9.1",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "better-sqlite3": "^12.4.1"
  }
}
