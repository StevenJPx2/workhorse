{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "worker/src/index.ts",
    "packages/*/src/index.ts",
    "plugins/*/index.ts",
    "plugins/*/plugin.ts",
    "evals/**/*.eval.ts",
    "evals/run.mjs",
    "sandbox/install.mjs",
    "workflows/*/index.ts",
    "plugins/*/tools/index.ts"
  ],
  "workspaces": {
    "patterns": [
      "packages/*",
      "plugins/*",
      "worker",
      "ui",
      "evals",
      "workflows/*"
    ]
  },
  "ignorePatterns": [
    "**/*.generated.ts",
    "**/.nuxt/**",
    "**/.wrangler/**"
  ],
  "ignoreExports": [
    {
      "file": "plugins/browser/tools/_shared.ts",
      "exports": [
        "WRAPPER"
      ]
    }
  ]
}
