{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "worker/src/index.ts",
    "packages/*/src/index.ts",
    "plugins/*/index.ts",
    "plugins/*/plugin.ts",
    "evals/**/*.eval.ts",
    "evals/run.mjs",
    "worker/sandbox/install.mjs",
    "workflows/*/index.ts",
    "plugins/*/tools/index.ts"
  ],
  "workspaces": {
    "patterns": [
      "packages/*",
      "plugins/*",
      "worker",
      "ui",
      "evals",
      "workflows/*"
    ]
  },
  // Imported ONLY by alchemy.run.ts (ignored below) and by the alchemy CLI.
  // platform-node/platform-bun are upstream peer deps marked optional but
  // imported unconditionally — the CLI throws ERR_MODULE_NOT_FOUND without them.
  "ignoreDependencies": [
    "alchemy",
    "effect",
    "@effect/platform-bun",
    "@effect/platform-node",
    // The faux provider is imported only by the ignored Node pilot fixture.
    "@earendil-works/pi-ai"
  ],
  "ignorePatterns": [
    "**/*.generated.ts",
    "**/.nuxt/**",
    "**/.wrangler/**",
    // Phase 7 infra-as-code, NOT the active deploy path (blocked on two Alchemy
    // v2 gaps, documented at the top of the file). Declaring it an ENTRY instead
    // would classify it as production code and mis-flag its dev-deps.
    "alchemy.run.ts",
    // Standalone Node pilot fixture; it is executed by the root Vitest worker
    // project but is not a production entry.
    "worker/test/flue-v2-pilot.test.ts"
  ],
  "ignoreExports": [
    {
      "file": "plugins/browser/tools/_shared.ts",
      "exports": [
        "WRAPPER"
      ]
    }
  ]
}
