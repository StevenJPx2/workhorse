{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "worker/src/index.ts",
    "packages/*/src/index.ts",
    "plugins/*/index.ts",
    "plugins/*/plugin.ts",
    "evals/**/*.eval.ts",
    "evals/run.mjs",
    "sandbox/install.mjs"
  ],
  "workspaces": {
    "patterns": ["packages/*", "plugins/*", "worker", "ui", "evals"]
  },
  "ignorePatterns": ["**/*.generated.ts", "**/.nuxt/**", "**/.wrangler/**"]
}
