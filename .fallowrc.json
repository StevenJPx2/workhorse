{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "worker/src/index.ts",
    "packages/*/src/index.ts",
    "plugins/*/index.ts",
    "plugins/*/plugin.ts",
    "evals/**/*.eval.ts",
    "evals/run.mjs",
    "worker/sandbox/install.mjs",
    "workflows/*/index.ts",
    "plugins/*/tools/index.ts"
  ],
  "workspaces": {
    "patterns": [
      "packages/*",
      "plugins/*",
      "worker",
      "ui",
      "evals",
      "workflows/*"
    ]
  },
  // Imported ONLY by alchemy.run.ts (ignored below) and by the alchemy CLI.
  // platform-node/platform-bun are upstream peer deps marked optional but
  // imported unconditionally — the CLI throws ERR_MODULE_NOT_FOUND without them.
  // Bundle-only deps for the pi-in-workerd build (worker/pi-build.mjs) are
  // declared at the ROOT workspace so esbuild can resolve the .bun store
  // symlink trees; they are never imported by workspace source, so fallow
  // cannot observe them — ignore by exact name.
  "ignoreDependencies": [
    "alchemy",
    "effect",
    "@effect/platform-bun",
    "@effect/platform-node",
    // The faux provider is imported only by the ignored Node pilot fixture.
    "@earendil-works/pi-ai",
    "@anthropic-ai/sdk",
    "@aws-sdk/client-bedrock-runtime",
    "@cloudflare/containers",
    "@earendil-works/pi-agent-core",
    "@earendil-works/pi-client",
    "@earendil-works/pi-protocol",
    "@earendil-works/pi-telemetry",
    "@earendil-works/pi-tui",
    "@google/genai",
    "@hono/node-server",
    "@hono/standard-validator",
    "@mariozechner/clipboard",
    "@mistralai/mistralai",
    "@modelcontextprotocol/sdk",
    "@opentelemetry/api",
    "@standard-community/standard-json",
    "@standard-community/standard-openapi",
    "@valibot/to-json-schema",
    "@workhorse/evals",
    "agentkeepalive",
    "ajv",
    "aws4fetch",
    "capnweb",
    "chalk",
    "cross-spawn",
    "diff",
    "eventsource",
    "glob",
    "grok-mermaid",
    "highlight.js",
    "hono",
    "hono-openapi",
    "hosted-git-info",
    "ignore",
    "jiti",
    "js-yaml",
    "just-bash",
    "minimatch",
    "openapi-types",
    "partial-json",
    "pkce-challenge",
    "proper-lockfile",
    "quansync",
    "semver",
    "typebox",
    "ulidx",
    "undici",
    "yaml",
    "@silvia-odwyer/photon-node",
    "@smithy/node-http-handler",
    "ajv-formats",
    "content-type",
    "cors",
    "eventsource-parser",
    "express",
    "express-rate-limit",
    "get-east-asian-width",
    "http-proxy-agent",
    "https-proxy-agent",
    "jose",
    "json-schema-typed",
    "marked",
    "openai",
    "raw-body",
    "zod-to-json-schema"
  ],
  "ignorePatterns": [
    "**/*.generated.ts",
    "**/.nuxt/**",
    "**/.wrangler/**",
    // Phase 7 infra-as-code, NOT the active deploy path (blocked on two Alchemy
    // v2 gaps, documented at the top of the file). Declaring it an ENTRY instead
    // would classify it as production code and mis-flag its dev-deps.
    "alchemy.run.ts"
  ],
  "ignoreExports": [
    {
      "file": "plugins/browser/tools/_shared.ts",
      "exports": [
        "WRAPPER"
      ]
    }
  ]
}
