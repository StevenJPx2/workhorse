{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "workhorse-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  // ctx.exports loopback bindings (for the Code Mode ToolBridge) are default
  // as of compat date 2025-11-17, so no explicit flag is needed.
  "compatibility_flags": ["nodejs_compat"],
  // Worker Loader: spin up isolated dynamic Workers on demand (Code Mode —
  // the agent writes TS that chains tools in one sandboxed run).
  "worker_loaders": [{ "binding": "LOADER" }],
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Self-healing sweep: re-dispatch errored tickets with heal budget left.
    "crons": ["*/15 * * * *"]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      // Repo root: the image build scans plugins/*/extension.ts for
      // sandbox-side plugin tools.
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 5
    }
  ],

  // Fleet-wide institutional knowledge: AI Search (AutoRAG) instance with
  // built-in storage. Corpus = archived run traces + ticket outcomes,
  // uploaded at archive time; searched by agents (search_fleet_knowledge)
  // and the fleet chat.
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "vars": {
    // This Worker's own public URL, so ticket sandboxes can call POST /browser.
    "SELF_URL": "https://workhorse-sandbox.stevenjpx2.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "TICKETS",
      "id": "aa4614982dcc48d1b532daf213441213"
    }
  ],
  // Relational plane: record-shaped data with relationships (tickets,
  // escalations, trace index, scripts). KV keeps hot small state (live:,
  // cursors, thread mappings, auth); blobs stay in KV until R2 lands.
  // Blob plane: things KV structurally can't hold (25 MiB value cap).
  // Trace bodies, oversized Magic Context dbs, dependency caches.
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "workhorse-blobs"
    }
  ],
  // Semantic plane: Workers AI embeddings + one Vectorize index namespaced
  // per corpus (scripts, workflows, tools) — the semindex toolkit.
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "workhorse-semindex"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workhorse",
      "database_id": "85f8b551-162f-4ecb-8430-10099f2d3da5",
      // Drizzle generates into worker/migrations from packages/db/src/schema.ts;
      // wrangler applies them and owns the ledger. This is the default path, but
      // stated explicitly so the coupling to drizzle.config.ts's `out` is visible.
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "ticket-workflow",
      "binding": "TICKET_WF",
      "class_name": "TicketWorkflow"
    }
  ],
  // The Alchemy v2 deploy (2026-07-29) uploaded the worker WITHOUT a migration
  // tag, clearing the recorded `v1`. Wrangler then tried to re-apply
  // new_sqlite_classes for a class that already has live objects, which
  // Cloudflare rejects (10074). `v1` is declared applied via an empty step so
  // wrangler's tag matches reality; the class itself is untouched.
  "migrations": [
    {
      "tag": "v1"
    }
  ]
}
