{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Vendored lint policy: maintained as upstream code, not analysed as ours.
  "ignorePatterns": ["tools/oxlint/anti-slop/**"],
  // @effect/tsgo: runs the `effect` task in vite.config.ts, which Fallow does not read.
  // workerd: the CLI resolves its platform binary by path (packages/cli/src/install.ts).
  "ignoreDependencies": ["@effect/tsgo", "workerd"],
  // Smoke scripts are run by hand (docs/architecture.md, "Proof"); nothing imports them.
  // Both budget entrypoints run in CI after the ordinary checks.
  "entry": ["smoke/[0-9]*.ts", "budgets/measure.ts", "budgets/link-memory.ts"],
  // Public methods of a WorkerEntrypoint or a DurableObject are called over Workers RPC, which
  // Fallow cannot see.
  "usedClassMembers": [
    { "extends": "WorkerEntrypoint", "members": ["*"] },
    { "extends": "DurableObject", "members": ["*"] }
  ]
}
